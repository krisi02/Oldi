@page "/driver-notifications"
@using DailyPlannerMauiBlazor.Repository
@using DailyPlannerMauiBlazor.Models
@inject IRepository Repository
@inject NavigationManager NavigationManager

<div class="page-container">
    <div class="header">
        <h1>Notifiche Autista</h1>
        <div class="header-actions">
            <button class="btn-refresh" @onclick="RefreshData" disabled="@IsLoading">
                @if (IsLoading)
                {
                    <span>Caricamento...</span>
                }
                else
                {
                    <span>🔄 Aggiorna</span>
                }
            </button>
            <button class="btn-logout" @onclick="Logout">Logout</button>
        </div>
    </div>

    <div class="content">
        @if (IsLoading)
        {
            <div class="loading-spinner">
                <div class="spinner"></div>
                <p>Caricamento notifiche...</p>
            </div>
        }
        else if (Plannings.Count == 0)
        {
            <div class="empty-state">
                <h2>📋 Nessuna notifica</h2>
                <p>Non ci sono pianificazioni da visualizzare al momento.</p>
            </div>
        }
        else
        {
            <div class="notifications-list">
                @foreach (var planning in Plannings)
                {
                    <div class="notification-card">
                        <div class="card-header">
                            <div class="card-title">
                                <h3>Pianificazione #@planning.Id</h3>
                            </div>
                            <div class="truck-info">
                                @if (planning.AssignedTruck != null)
                                {
                                    <div class="truck-number">@planning.AssignedTruck.TruckInternalNumber</div>
                                    <div class="truck-type">@planning.AssignedTruck.TruckType</div>
                                }
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="info-row">
                                <span class="icon">📅</span>
                                <span>@planning.Day.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="info-row">
                                <span class="icon">🕐</span>
                                <span>@planning.PlanningStartingTime.ToString("HH:mm") - @planning.PlanningEndingTime.ToString("HH:mm")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(planning.PlannedPlantName))
                            {
                                <div class="info-row">
                                    <span class="icon">📍</span>
                                    <span>@planning.PlannedPlantName</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(planning.Note))
                            {
                                <div class="info-row note">
                                    <span class="icon">✉️</span>
                                    <span>@planning.Note</span>
                                </div>
                            }
                            <div class="info-row">
                                <span class="icon">ℹ️</span>
                                <span>Stato: @planning.StatusDescription</span>
                            </div>
                        </div>
                        @if (planning.StatusCode == 0)
                        {
                            <div class="card-footer">
                                <button class="btn-confirm" @onclick="() => ConfirmPlanning(planning.Id)">
                                    CONFERMA
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private bool IsLoading { get; set; } = false;
    private List<DailyPlannerMauiBlazor.Models.Planning> Plannings { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        // Check if user is logged in and has correct role
        var isLogged = await Repository.IsUserLoggedAsync();
        if (!isLogged)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        IsLoading = true;
        try
        {
            var response = await Repository.GetDriverNotifications();
            if (response.Success && response.Item != null && response.Item.Plannings != null)
            {
                Plannings = response.Item.Plannings;
            }
            else
            {
                Plannings = new List<DailyPlannerMauiBlazor.Models.Planning>();
            }
        }
        catch (Exception)
        {
            Plannings = new List<DailyPlannerMauiBlazor.Models.Planning>();
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task RefreshData()
    {
        await LoadData();
    }

    private async Task ConfirmPlanning(int planningId)
    {
        IsLoading = true;
        try
        {
            var userId = DailyPlannerMauiBlazor.Settings.Settings.Default.LoggedUserId;
            var response = await Repository.DriverPlanningConfirmation(new DriverPlanningConfirmation
            {
                PlanningId = planningId,
                UserId = userId
            });

            if (response.Success)
            {
                await LoadData();
            }
        }
        catch (Exception)
        {
            // Handle error
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task Logout()
    {
        try
        {
            var userId = DailyPlannerMauiBlazor.Settings.Settings.Default.LoggedUserId;
            await Repository.LogoutAsync(userId);
        }
        catch (Exception)
        {
            await Repository.ForceUserLogout();
        }
        finally
        {
            NavigationManager.NavigateTo("/login");
        }
    }
}

<style>
    .page-container {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background-color: #f5f5f5;
    }

    .header {
        background-color: #0067B3;
        color: white;
        padding: 15px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    .header h1 {
        margin: 0;
        font-size: 20px;
    }

    .header-actions {
        display: flex;
        gap: 10px;
    }

    .btn-refresh, .btn-logout {
        padding: 8px 16px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
        font-weight: bold;
    }

    .btn-refresh {
        background-color: rgba(255, 255, 255, 0.2);
        color: white;
    }

    .btn-logout {
        background-color: #d21c26;
        color: white;
    }

    .content {
        flex: 1;
        overflow-y: auto;
        padding: 10px;
    }

    .loading-spinner {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 200px;
    }

    .spinner {
        border: 4px solid #f3f3f3;
        border-top: 4px solid #d21c26;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    .empty-state {
        text-align: center;
        padding: 40px 20px;
        color: #666;
    }

    .notifications-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .notification-card {
        background: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        padding: 12px;
        background-color: #0067B3;
    }

    .card-title h3 {
        margin: 0;
        color: white;
        font-size: 16px;
    }

    .truck-info {
        text-align: center;
        color: white;
    }

    .truck-number {
        font-size: 18px;
        font-weight: bold;
    }

    .truck-type {
        font-size: 14px;
    }

    .card-body {
        padding: 12px;
    }

    .info-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 6px 0;
        color: #575757;
    }

    .info-row.note {
        color: blue;
    }

    .icon {
        font-size: 18px;
        min-width: 24px;
        text-align: center;
    }

    .card-footer {
        padding: 12px;
        border-top: 1px solid #eee;
        text-align: right;
    }

    .btn-confirm {
        background-color: #3bcf27;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 4px;
        font-weight: bold;
        cursor: pointer;
    }

    .btn-confirm:hover {
        background-color: #32b020;
    }
</style>
