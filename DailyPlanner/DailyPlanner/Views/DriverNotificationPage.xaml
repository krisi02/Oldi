<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:prism="http://prismlibrary.com"
             prism:ViewModelLocator.AutowireViewModel="True"
             xmlns:fontawsome="clr-namespace:FontAwesome"
             Title="NOTIFICHE"
             x:Class="DailyPlanner.Views.DriverNotificationPage">
    <ContentPage.ToolbarItems>
        <ToolbarItem Order="Primary" Name="Aggiorna" Command="{Binding RefreshData}">
            <ToolbarItem.IconImageSource>
                <FontImageSource Glyph="{x:Static fontawsome:FontAwesomeIcons.SyncAlt}" FontFamily="FA-Solid" Size="Small"/>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <ListView
				x:Name="listView"
				SeparatorVisibility="None"
                SelectionMode="None"
				HasUnevenRows="true"
				ItemsSource="{Binding NotificationList}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Frame x:Name="Item" Padding="0" OutlineColor="#CCCCCC" Style="{StaticResource FrameStyle}">
                            <Grid Margin="0,0,0,0" Padding="0" ColumnSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <BoxView
                                        HorizontalOptions="Fill"
                                                 VerticalOptions="Fill"
                                                 Grid.ColumnSpan="5"
                                                 Grid.Row="0"
                                                 Grid.Column="0" 
                                        Margin="0,0,0,-1"
                                        
                                        BackgroundColor="#CCCCCC"
                                        />
                                <!--CARD TITLE Margin="8,1,0,0" -->
                                <StackLayout Padding="8,0,0,0"
                                                 Margin="1,1,0,0"
                                                 HorizontalOptions="Fill"
                                                 VerticalOptions="Fill"
                                                 Grid.ColumnSpan="4"
                                                 Grid.Row="0"
                                                 Grid.Column="0" 
                                                 
                                                 BackgroundColor="White"
                                                 >
                                    <Label
                                            Text="{Binding Title}" 
                                            TextColor="#5c5d5e"
                                            FontAttributes="Bold"
                                            FontSize="18"
                                            Margin="0"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="CenterAndExpand"/>
                                </StackLayout>

                                <!--TRUCK NUMBER AND TYPE-->
                                <StackLayout Margin="0,1,1,0" 
                                                 Grid.Column="4" 
                                                 Grid.Row="0"
                                                 Padding="0" 
                                                 Spacing="2" 
                                                 HorizontalOptions="Fill" 
                                                 BackgroundColor="{Binding TruckTypeColor}">
                                    <!-- {{BindingTruckInternalNumber}-->
                                    <Label Text="{Binding TruckInternalNumber}" 
                                               FontAttributes="Bold"
                                               TextColor="White" 
                                               HorizontalOptions="Center" 
                                               VerticalOptions="Fill" 
                                               FontSize="18"
                                               HorizontalTextAlignment="Center" 
                                               VerticalTextAlignment="Center" />

                                    <!-- {{Binding TruckTypeDescription}-->
                                    <Label Text="{Binding TruckTypeDescription}" 
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               HorizontalOptions="Center" 
                                               VerticalOptions="Start" 
                                               FontSize="18"
                                               HorizontalTextAlignment="Center" 
                                               VerticalTextAlignment="Center" />
                                </StackLayout>

                                <!--PLANNING TIME GRID-->
                                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"  Margin="10,6,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8*" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Text="{x:Static fontawsome:FontAwesomeIcons.Clock}" 
                                               FontFamily="FA-Regular"
                                               TextColor="#575757"
								               FontSize="18"
                                               Padding="0"
                                               Margin="0"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"/>
                                    <!-- {Binding WorkingHoursDescription} FontAttributes="Bold" -->
                                    <Label Grid.Column="1" Text="{Binding StartingTime}"
                                               TextColor="#575757"
								               FontSize="16"
                                               Margin="0"
                                               Padding="0"
                                               VerticalOptions="Center"/>
                                </Grid>

                                <!--STARTING PLANT NAME GRID-->
                                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Margin="10,6,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8*" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Text="{x:Static fontawsome:FontAwesomeIcons.MapMarkerAlt}" 
                                               FontFamily="FA-Solid"
                                               TextColor="#575757"
								               FontSize="18"
                                               Padding="0"
                                               Margin="0"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"/>
                                    <!-- {{Binding Ricevuto}-->
                                    <Label Grid.Column="1" Text="{Binding StartingPlantName}"
                                               TextColor="#575757"
								               FontSize="16"
                                               Margin="0"
                                               Padding="0"
                                               VerticalOptions="Center"/>
                                </Grid>

                                <!--PLANNING CONFIRMED NAME GRID-->
                                <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Margin="10,6,0,0" IsVisible="{Binding IsConfirmed}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8*" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Text="{x:Static fontawsome:FontAwesomeIcons.Check}" 
                                               FontFamily="FA-Solid"
                                               TextColor="Green"
								               FontSize="18"
                                               Padding="0"
                                               Margin="0"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding ConfirmationMessage}"
                                               TextColor="#575757"
								               FontSize="16"
                                               Margin="0"
                                               Padding="0"
                                               VerticalOptions="Center"/>
                                </Grid>


                                <!--PLANNING NOTE GRID-->
                                <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" Margin="10,6,0,0" IsVisible="{Binding IsNoteVisible}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8*" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Text="{x:Static fontawsome:FontAwesomeIcons.Envelope}" 
                                               FontFamily="FA-Regular"
								               TextColor="Blue"
								               FontSize="18"
                                               Padding="0"
                                               Margin="0"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"/>

                                    <Label Grid.Column="1" Text="{Binding DriverNote}"
                                               TextColor="#575757"
								               FontSize="16"
                                               Margin="0"
                                               Padding="0"
                                               VerticalOptions="Center"/>
                                    <!-- {{Binding Ricevuto}
                                    <Button Grid.Column="1" 
                                                Text="Visualizza nota allegata" 
                                                BindingContext="{Binding Source={x:Reference listView}, Path=BindingContext}"  
                                                CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}"
                                                Command="{Binding ReadNote}"
								                FontAttributes="Bold,Italic"
                                                BackgroundColor="Transparent"
								                TextColor="Blue"
								                FontSize="14"
                                                Margin="0,0,0,0"
                                                Padding="0"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Start"/>-->
                                </Grid>

                                
                                <!--CONFIRM BUTTON-->
                                <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="5"  Margin="10,6,10,8" IsVisible="{Binding IsConfirmationButtonVisible}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackLayout Grid.Row="0" 
                                                     Grid.Column="2" 
                                                     Margin="0"
                                                     HorizontalOptions="Fill" 
                                                     VerticalOptions="Fill"
                                                     IsVisible="{Binding IsUpdatable}"
                                                     >
                                        <Button Text="CONFERMA"  
                                                    BindingContext="{Binding Source={x:Reference listView}, Path=BindingContext}"  
                                                    CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}"
                                                    Command="{Binding ConfirmPlanning}"
                                                    Margin="0" 
                                                    TextColor="White" 
                                                    HorizontalOptions="Fill" 
                                                    VerticalOptions="Center"
                                                    BackgroundColor="#3bcf27"
                                                    />
                                    </StackLayout>
                                </Grid>

                            </Grid>
                        </Frame>

                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </ContentPage.Content>
</ContentPage>