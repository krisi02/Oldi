<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:prism="http://prismlibrary.com"
             prism:ViewModelLocator.AutowireViewModel="True"
             xmlns:fontawsome="clr-namespace:FontAwesome"
             Title="SELEZIONE AUTISTA"
             x:Class="DailyPlanner.Views.PlanningCreation.AdminFreePlanDriverSelection">
    <ContentPage.ToolbarItems>
        <ToolbarItem Order="Primary" Name="Cambia Visualizzazione" Command="{Binding ChangeView}">
            <ToolbarItem.IconImageSource>
                <FontImageSource Glyph="{x:Static fontawsome:FontAwesomeIcons.Eye}" FontFamily="FA-Solid" Size="Small"/>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>

        <Grid VerticalOptions="Fill" HorizontalOptions="Fill">
            <StackLayout Orientation="Vertical">
                <Grid BackgroundColor="#008AC9" Margin="0,-10,0,0" MinimumHeightRequest="100" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Entry Margin="10,10,10,0" HorizontalOptions="Fill" Grid.Column="0" Text="{Binding SearchFilter, Mode=TwoWay}" TextColor="White"  Placeholder="Filtro Autisti">
                        <Entry.PlaceholderColor>
                            <OnPlatform x:TypeArguments="Color">
                                <On Platform="iOS" Value="White"></On>
                                <On Platform="Android" Value="White"></On>
                            </OnPlatform>
                        </Entry.PlaceholderColor>
                    </Entry>
                </Grid>
                <Grid Margin="10,4,10,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="6*" />
                    </Grid.ColumnDefinitions>
                    <!--TRUCK NUMBER AND TYPE-->
                    <StackLayout Margin="0"
                             Grid.Column="0" 
                             Grid.Row="0"
                             Spacing="2" 
                             HorizontalOptions="Fill" 
                             BackgroundColor="{Binding TruckTypeColor}">
                        <!-- {{BindingTruckInternalNumber}-->
                        <Label Text="{Binding TruckInternalNumber}" 
                           FontAttributes="Bold"                       
                           TextColor="White" 
                    FontSize="18"
                           HorizontalOptions="Center" 
                           VerticalOptions="Fill" 
                           HorizontalTextAlignment="Center" 
                           VerticalTextAlignment="Center" />
                        <Label Text="{Binding TruckTypeDescription}" 
                           FontAttributes="Bold"
                           TextColor="White"
                    FontSize="18"
                           HorizontalOptions="Center" 
                           VerticalOptions="Start" 
                           HorizontalTextAlignment="Center" 
                           VerticalTextAlignment="Center" />
                    </StackLayout>

                    <Label 
                    Margin="0,0,0,0" 
                    Grid.Row="0"
                    Grid.Column="1"
                    FontSize="18"
                    Text="{Binding Description}" 
                    TextColor="#5c5d5e"
                    FontAttributes="Bold"
                    HorizontalOptions="Start" 
                    VerticalOptions="Center" 
                    HorizontalTextAlignment="Center" 
                    VerticalTextAlignment="Center" />


                </Grid>
                <BoxView 
                HeightRequest="1"
                Color="LightGray"
                Margin ="0"/>
                <Label Text="{Binding MessageLabel}" TextColor="#008AC9" FontSize="18" FontAttributes="Bold" Margin="10"/>

                <ListView
			x:Name="listView"
			SeparatorVisibility="Default"
			HasUnevenRows="true"
			ItemsSource="{Binding PlanningDrivers}">
                    <ListView.Behaviors>
                        <prism:EventToCommandBehavior EventName="ItemTapped"
                                          Command="{Binding SelectedDriver}"
                                          EventArgsParameterPath ="Item" />
                    </ListView.Behaviors>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <Grid Margin="10,4,0,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                    </Grid.ColumnDefinitions>

                                    <Label 
                            Margin="8,8,8,8" 
                            Grid.Row="0"
                            FontSize="24" 
                            Text="{Binding DriverName}" 
                            TextColor="#5c5d5e"
                            FontAttributes="Bold"
                            HorizontalOptions="Start" 
                            VerticalOptions="Center" 
                            HorizontalTextAlignment="Center" 
                            VerticalTextAlignment="Center" />


                                </Grid>

                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackLayout>

            <Grid VerticalOptions="Fill" HorizontalOptions="Fill" BackgroundColor="#40000000" IsVisible="{Binding IsBusy}">
                <ActivityIndicator
				    IsRunning="{Binding IsBusy}"
				    Color="#d21c26"
				    VerticalOptions="CenterAndExpand"
				    HorizontalOptions="CenterAndExpand" />
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>